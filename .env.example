# ------------------------------------------------------------------
# FIAP Cloud Games - Orchestration
# LOCAL / DEVELOPMENT placeholder values ONLY. Never commit a real .env.
#
# Usage:
#   cp .env.example .env
# Compose also provides safe fallback defaults, so it runs even with
# no .env present.
# ------------------------------------------------------------------

# --- PostgreSQL (dev credentials - NOT for production) ---
POSTGRES_USER=fcg
POSTGRES_PASSWORD=fcg
POSTGRES_DB=fcg

# --- Kafka bootstrap endpoints ---
# Internal: used by services running INSIDE the docker network (from M1).
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
# Host: used by services running on the host machine during development.
KAFKA_HOST_BOOTSTRAP=localhost:29092

# --- JWT shared secret (UNUSED in M0) ---
# Consumed by UsersAPI (issuer) and CatalogAPI (validator) from M1 onwards.
# Placeholder only - replace locally with a strong random 32+ char secret.
JWT__SECRETKEY=dev-only-change-me-please-min-32-characters-placeholder
JWT__ISSUER=FiapCloudGames
JWT__AUDIENCE=FiapCloudGames
