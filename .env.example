# ------------------------------------------------------------------
# FIAP Cloud Games - Orchestration
# LOCAL / DEVELOPMENT placeholder values ONLY. Never commit a real .env.
#
# Usage:
#   cp .env.example .env
# Compose also provides safe fallback defaults, so it runs even with
# no .env present.
# ------------------------------------------------------------------

# --- PostgreSQL (dev credentials - NOT for production) ---
POSTGRES_USER=fcg
POSTGRES_PASSWORD=fcg
POSTGRES_DB=fcg

# --- MongoDB (dev credentials - NOT for production) ---
# Root user of the local mongo container; PaymentsAPI connects with these values
# (Mongo__ConnectionString is composed in docker-compose.yml).
MONGO_USER=fcg
MONGO_PASSWORD=fcg

# --- Kafka bootstrap endpoints ---
# Internal: used by services running INSIDE the docker network.
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
# Host: used by services/functions running on the host machine during development
# (must match KAFKA_HOST_PORT below).
KAFKA_HOST_BOOTSTRAP=localhost:29092

# --- JWT shared secret ---
# Consumed by UsersAPI (issuer), CatalogAPI (validator) and validated at the edge by
# Kong (gateway/kong.yml carries the same placeholder and must be kept in sync).
# Placeholder only - replace locally with a strong random 32+ char secret.
JWT__SECRETKEY=dev-only-change-me-please-min-32-characters-placeholder
JWT__ISSUER=FiapCloudGames
JWT__AUDIENCE=FiapCloudGames

# --- Grafana (dev credentials - NOT for production) ---
# Local admin login for the provisioned Grafana (http://localhost:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Host ports (Phase 3) ---
# Only the HOST side of each port mapping. Containers keep their internal ports and
# talk to each other through the compose DNS names (postgres:5432, redis:6379,
# mongo:27017, kafka:9092, users-api:8080, ...). Change a value here when the default
# port is already taken on your machine (e.g. another PostgreSQL on 5432 or Redis on 6379).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MONGO_HOST_PORT=27017
KAFKA_HOST_PORT=29092
USERS_API_HOST_PORT=8080
CATALOG_API_HOST_PORT=8082
PAYMENTS_API_HOST_PORT=8083
NOTIFICATIONS_API_HOST_PORT=8081
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_STATUS_PORT=8100
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100
ALLOY_HOST_PORT=12345
